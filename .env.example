# Server configuration only. Do not place these values in content.json, build.js, HTML or public assets.
# Copy to a gitignored .env.local for local development; configure Production values in Vercel separately.
INTAKE_ENABLED=false
# Set true only after the provisioning and verification procedure in docs/intake-setup.md.
INTAKE_PROVISIONED=false
INTAKE_ALLOWED_ORIGINS=https://hammadmedia.com,https://www.hammadmedia.com

# Dedicated operational outbox. NOT the existing CRM database or another application's Supabase project.
INTAKE_SUPABASE_URL=
INTAKE_SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback supported: INTAKE_SUPABASE_SERVICE_ROLE_KEY (never use anon/publishable).

# Separate Notion connection with Read + Insert content, shared only with the existing Lead Ledger.
# The fixed canonical data source ID lives in server code; no new CRM is created.
INTAKE_NOTION_TOKEN=

# Resend verified sender, preferably a sending subdomain. Recipient is fixed in server code.
RESEND_API_KEY=
RESEND_FROM_EMAIL=intake@notifications.hammadmedia.com

# Site key is public through /api/intake-config only when enabled. Secret always stays on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Two different cryptographically random secrets, each at least 32 characters.
INTAKE_HASH_SECRET=
CRON_SECRET=
